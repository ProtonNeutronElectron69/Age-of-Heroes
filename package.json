{
  "name": "age-of-heroes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aoh/client dev",
    "build": "pnpm --filter @aoh/client --filter @aoh/server build",
    "server": "pnpm --filter @aoh/server build && pnpm --filter @aoh/server start",
    "preview": "pnpm --filter @aoh/client preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @aoh/client e2e"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
